<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored from https://github.com/Stumpii/ScintillaNET-FindReplaceDialog (MIT, see LICENSE),
    commit 9fb9c948a6d765c8b879f3b36f301e4a5f4d3b62. The published NuGet package is compiled
    against the unsigned Scintilla.NET 5.3 assembly and can't bind to the strong-named
    Scintilla5.NET assembly, so it is built here against Scintilla5.NET instead.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScintillaNET_FindReplaceDialog</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Upstream source is kept unmodified; it predates the .NET 9 WinForms serialization analyzer -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scintilla5.NET" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
